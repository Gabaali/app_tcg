  "official_faq": [
    {
      "question": "If this card is my Leader, can I activate the [Trigger] effects of my face-up Life cards?",
      "answer": "No, you cannot.",
      "updated_on": "2024-04-05"
    },
    {
      "question": "If this card is my Leader, can I activate and resolve the effect of \"ST13-012 Makino\" (\"[On Play] You may add 1 card from the top or bottom of your Life cards to your hand: Look at all of your Life cards and place them back in your Life area in any order.\") by placing 1 of my face-up Life cards at the bottom of my deck instead of adding it to my hand?",
      "answer": "You can use this [On Play] effect to place 1 face-up Life card at the bottom of your deck instead of adding it to your hand, but because you have not paid the cost \"You may add 1 card from the top or bottom of your Life cards to your hand:\", nothing will happen.",
      "updated_on": "2024-04-05"
    },
    {
      "question": "If this card is my Leader, and I have 1 face-up Life card, and my opponent has 1 Life card, can I activate the \"• If your opponent has 1 Life card, deal 1 damage to your opponent. Then, add 1 card from the top of your Life cards to your hand.\" effect of \"OP06-116 Reject\"?",
      "answer": "You will deal 1 damage to your opponent and then put your 1 Life card at the bottom of your deck.",
      "updated_on": "2024-04-05"
    },
    {
      "question": "Can I use this [Activate: Main] effect to add 1 card from my hand and 1 card from my trash (a total of 2 cards) to the top of my Life cards face-up?",
      "answer": "Yes, you can.",
      "updated_on": "2024-04-05"
    }
  ]
