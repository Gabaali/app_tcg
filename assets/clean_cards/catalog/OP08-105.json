  "official_faq": [
    {
      "question": "When one of my opponent's Life cards is moved to my opponent's hand or trashed based on the effect of one of my opponent's cards, can I use this [Your Turn] effect to draw 2 cards and trash 1 card from my hand?",
      "answer": "Yes, you can.",
      "updated_on": "2024-08-30"
    },
    {
      "question": "Can I use this \"When a card is removed from your opponent's Life cards\" effect when looking at my opponent's Life cards, when my opponent reveals their Life cards, or when my opponent changes the order of their Life cards?",
      "answer": "No, you cannot. You can only use this effect when one of your opponent's Life cards is moved from their Life area to another area.",
      "updated_on": "2024-08-30"
    },
    {
      "question": "During my turn, my opponent used an effect to add 1 Life card to their hand, then added a card to the top of their Life cards. Can I still use this [Your Turn] effect to draw 2 cards and trash 1 card from my hand?",
      "answer": "Yes, you can.",
      "updated_on": "2024-08-30"
    },
    {
      "question": "If I deal damage to my opponent and one of his Life cards has a [Trigger] effect, does this \"When a card is removed from your opponent's Life cards\" effect activate before the [Trigger] effect?",
      "answer": "In this case, your opponent chooses whether or not to activate the [Trigger] effect. If they choose to activate it, the [Trigger] effect activates first, followed by the \"When a card is removed from your opponent's Life cards\" effect, provided this Character is still on the field.",
      "updated_on": "2024-08-30"
    }
  ]
