  "official_faq": [
    {
      "question": "Does the \"2 or less Characters\" in \"If you have 2 or less Characters with 5000 power or more,\" include this Character?",
      "answer": "Yes. You must have 2 or less Characters with 5000 power or more including \"EB02-022 Usopp\" in order to use this effect.",
      "updated_on": "2025-04-25"
    },
    {
      "question": "I played this card when my opponent had 1 \"OP09-004 Shanks\" on their field and I had 2 Characters with a current power of 5000 or more on my field. In this case, how many Characters with 5000 power or more am I considered to have when activating this [On Play] effect?",
      "answer": "In this case, this card's power will be 4000, so you will be considered to have 2 Characters with 5000 power or more. You will therefore be able to use this [On Play] effect to play a Character card from your hand.",
      "updated_on": "2025-04-25"
    }
  ]
