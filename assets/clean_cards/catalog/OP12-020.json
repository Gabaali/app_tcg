  "official_faq": [
    {
      "question": "When I used this card to attack my opponent's Leader, my opponent activated the [Blocker] of one of their Characters, and I battled against that Character. Can I use this [Activate: Main] effect to set this card to active after the battle?",
      "answer": "Yes, you can.",
      "updated_on": "2026-02-06"
    },
    {
      "question": "When I used this card to attack one of my opponent's Characters, my opponent activated the [Blocker] of their Leader \"OP05-022 Donquixote Rosinante\", and I battled against [Donquixote Rosinante]. Can I use this [Activate: Main] effect to set this card to active after the battle?",
      "answer": "No, you cannot.",
      "updated_on": "2026-02-06"
    },
    {
      "question": "I attacked my opponent's Character with this card while 2 DON!! cards were given to it, then battled against that Character. After the battle, can I give 1 more DON!! card to this card to fulfill the [DON!! x3] condition, then use its [Activate: Main] effect to set it to active?",
      "answer": "Yes, you can.",
      "updated_on": "2026-02-06"
    },
    {
      "question": "While battling this Character, my opponent's Character was removed from the field by an effect during either the Attack Step, Block Step, or Counter Step. In this case, can I still activate this Character's effect?",
      "answer": "No, you cannot.",
      "updated_on": "2026-02-06"
    }
  ]
