  "official_faq": [
    {
      "question": "Can I use this [On Play] effect and [When Attacking] effect to return my own Character to my hand?",
      "answer": "Yes, you can.",
      "updated_on": "2024-04-05"
    },
    {
      "question": "Can I play or attack with this Character if I do not have 2 cards in my hand?",
      "answer": "Yes, you can. However, you cannot activate its [On Play] effect or [When Attacking] effect.",
      "updated_on": "2024-04-05"
    },
    {
      "question": "Can I activate this [On Play] or [When Attacking] effect, trash 2 cards from my hand, and then choose not to return 1 Character to the owner's hand?",
      "answer": "Yes, you can. \"Return up to 1 Character\" means you can choose 0 Characters. In that case, this Character will still gain [Double Attack] during that turn.",
      "updated_on": "2024-04-05"
    }
