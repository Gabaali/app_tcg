  "official_faq": [
    {
      "question": "Imagine I have 1 DON!! attached to this Leader and 5 Characters on my field. Then, in order to play a new Character card, I trash one of my Characters with the {Impel Down} type to play it. Can I still use this card's effect to play 1 [Prisoner of Impel Down] card from my hand?",
      "answer": "No, you cannot.",
      "updated_on": "2026-08-21"
    },
    {
      "question": "Imagine I have 1 DON!! attached to this Leader, and one of my {Impel Down} type Character cards is returned to my hand due to the effect of \"OP07-056 Slave Arrow\" or another effect. Can I use this Leader's effect to play 1 [Prisoner of Impel Down] from my hand?",
      "answer": "Yes, you can. You can activate this card's effect even if an {Impel Down} type Character was removed from the field due to your own effect.",
      "updated_on": "2026-08-21"
    }
  ]
