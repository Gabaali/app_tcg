  "official_faq": [
    {
      "question": "Does \"If you have 3 or less Life cards\" mean if my current number of Life cards is 3 or less?",
      "answer": "Yes, it refers to the number of Life cards you currently have.",
      "updated_on": "2024-04-05"
    },
    {
      "question": "If I have activated this [Main] effect, can I pay the cost of \" You may add 1 card from the top of your Life cards to your hand: \" during this turn?",
      "answer": "No, you cannot. The effect cannot be activated because that activation cost cannot be paid.",
      "updated_on": "2024-04-05"
    },
    {
      "question": "Can I activate this [Main] effect when I have 4 or more Life cards?",
      "answer": "Yes. You can activate the effect, but nothing will happen according to the [Main] effect.",
      "updated_on": "2024-04-05"
    }
  ]
