  "official_faq": [
    {
      "question": "After activating this [When Attacking] effect and trashing 1 card from my hand, if my opponent chooses “• Trash 1 card from your hand. Then, add up to 1 card from the top of your deck to the top of your Life cards.”, which player trashes a card from their hand?",
      "answer": "The player who activated this [When Attacking] effect trashes 1 additional card from their hand, then adds up to 1 card from the top of their deck to the top of their Life cards.",
      "updated_on": "2026-08-21"
    },
    {
      "question": "If I have 1 card in my hand and activate this [When Attacking] effect by trashing that card, then my opponent chooses “• Trash 1 card from your hand. Then, add up to 1 card from the top of your deck to the top of your Life cards.”, what happens?",
      "answer": "In this case, since you have no cards in your hand when resolving “• Trash 1 card from your hand. Then, add up to 1 card from the top of your deck to the top of your Life cards.”, you do not trash a card and add up to 1 card from the top of your deck to the top of your Life cards.",
      "updated_on": "2026-08-21"
    },
    {
      "question": "After activating this [When Attacking] effect and trashing 1 card from my hand, if my opponent chooses “• Trash 1 card from your opponent's hand.”, how is the card to be trashed chosen?",
      "answer": "In this case, the player who activated this [When Attacking] effect randomly chooses 1 card from their opponent's hand without looking at it, and the opponent trashes that card.",
      "updated_on": "2026-08-21"
    }
  ]
