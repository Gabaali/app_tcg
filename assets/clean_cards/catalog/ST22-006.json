  "official_faq": [
    {
      "question": "If I use this [On Play] effect to reveal 1 card from the top of my deck and that card's type includes \"Whitebeard Pirates\", what do I do with that card?",
      "answer": "In this case, you draw 2 cards from the top of your deck, including the revealed card. You will then trash 1 card from your hand.",
      "updated_on": "2025-08-22"
    },
    {
      "question": "If I use this [On Play] effect to reveal 1 card from the top of my deck and that card's type does not include \"Whitebeard Pirates\", what do I do with that card?",
      "answer": "In this case, you will return the revealed card to the top of your deck face-down.",
      "updated_on": "2025-08-22"
    }
  ]
