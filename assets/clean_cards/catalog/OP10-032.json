  "official_faq": [
    {
      "question": "If I have a green Character that would be removed from the field by my opponent's effect while this Character is rested, can I still use this Character's effect to rest this Character instead?",
      "answer": "No, you cannot.",
      "updated_on": "2025-02-28"
    },
    {
      "question": "If both this Character and a green Character other than this Character are K.O.'d at the same time while this Character is active, can I still use this effect to rest this Character instead?",
      "answer": "Yes, you can. In this case, your other green Character will not be K.O.'d, but [Tashigi] will still be K.O.'d.",
      "updated_on": "2025-02-28"
    }
  ]
