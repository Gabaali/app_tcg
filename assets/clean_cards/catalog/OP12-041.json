  "official_faq": [
    {
      "question": "Is the Event activated as part of this [Activate: Main] effect trashed?",
      "answer": "Yes, it is.",
      "updated_on": "2026-02-06"
    },
    {
      "question": "Do I pay a cost when activating an Event using this [Activate: Main] effect?",
      "answer": "You do not pay the cost shown in the upper left of the card, but you must pay any activation cost written in the effect text, such as \"DON!! −2\".",
      "updated_on": "2026-02-06"
    },
    {
      "question": "When using this [Activate: Main] effect to activate \"OP09-077 Gum-Gum Lightning\", do I still have to return 2 DON!! cards from my field to my DON!! deck?",
      "answer": "Yes, you do.",
      "updated_on": "2026-02-06"
    },
    {
      "question": "When using this [Activate: Main] effect to activate an Event, can I activate the \"When you activate an Event\" effect of \"OP04-053 Page One\"?",
      "answer": "Yes, you can.",
      "updated_on": "2026-02-06"
    },
    {
      "question": "Can I use this [Activate: Main] effect to activate the [Counter] or [Trigger] effects of Events?",
      "answer": "No, you cannot. You can use this effect to activate the [Main] effects of Events with [Main] effects.",
      "updated_on": "2026-02-06"
    }
  ]
