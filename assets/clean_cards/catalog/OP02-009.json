  "official_faq": [
    {
      "question": "Can I play this Character if I have no Life cards, or cannot add a Life card to my hand?",
      "answer": "Yes, you can. You can use the [On Play] effect to reduce the power of your opponent's Character, but you cannot add a Life card to your hand.",
      "updated_on": "2024-04-05"
    },
    {
      "question": "When I play this Character, can I choose not to activate the [On Play] effect and not add a Life card to my hand?",
      "answer": "No, you cannot. The [On Play] effect is always activated, and you must add 1 Life card to your hand whenever possible.",
      "updated_on": "2024-04-05"
    },
    {
      "question": "If I do not use this [On Play] effect to give my opponent's Character −4000 power, can I choose not to add 1 card from the top of my Life cards to my hand?",
      "answer": "No, you cannot. Even if you do not give −4000 power, you must add 1 Life card to your hand whenever possible.",
      "updated_on": "2024-04-05"
    }
  ]
