  "official_faq": [
    {
      "question": "Can a Character with a cost of 8 or less with an [On Play]/[When Attacking] effect gain [Rush] using this [Activate: Main] effect?",
      "answer": "No, it cannot.",
      "updated_on": "2024-10-25"
    },
    {
      "question": "If I play a Character without an [On Play] effect and with a cost of 8 or less during my first turn and it gains [Rush] using this [Activate: Main] effect, can that Character attack?",
      "answer": "No, it cannot.",
      "updated_on": "2024-10-25"
    },
    {
      "question": "Can I use this [Activate: Main] effect to give [Rush] to \"OP05- 005 Karasu\", which has the \"[On Play] If your Leader has the {Revolutionary Army} type, give up to 1 of your opponent's Leader or Character cards −1000 power during this turn\" effect when using this Leader, which does not have the {Revolutionary Army} type?",
      "answer": "No, you cannot.",
      "updated_on": "2024-10-25"
    },
    {
      "question": "Can a Character with a cost of 8 or less and an effect such as \"[On Play] You may trash 1 card from your hand:\" gain [Rush] using this Leader's [Activate: Main] effect in the event that the activation cost was not paid and its [On Play] effect did not trigger?",
