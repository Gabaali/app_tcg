  "official_faq": [
    {
      "question": "After looking at 5 cards from the top of my deck, can I place 1 card on the top and 4 cards on the bottom?",
      "answer": "No, you cannot. After deciding the order in which you want to place the 5 cards, you must choose whether to return all 5 cards to the top or bottom of the deck.",
      "updated_on": "2024-04-05"
    },
    {
      "question": "What happens according to this [On Play] effect if I have 4 or less cards in my deck?",
      "answer": "You will be able to look at all of the 4 or less cards in your deck. While looking at your deck, the number of cards in your deck will not be considered 0.",
      "updated_on": "2024-04-05"
    }
  ]
