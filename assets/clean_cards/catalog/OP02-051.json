    {
      "question": "Can I use this [On Play] effect to play a Character card if I have 3 or more cards in my hand?",
      "answer": "Yes, you can.",
      "updated_on": "2024-04-05"
    },
    {
      "question": "If I have 4 or more cards in my hand, do I need to trash some of them in order to have 3 cards in my hand for this [On Play] effect?",
