  "official_faq": [
    {
      "question": "During a turn in which I use this [Activate: Main] effect to set 3 of my DON!! cards as active, can I play Character cards using other effects?",
      "answer": "No, you cannot.",
      "updated_on": "2026-06-26"
    },
    {
      "question": "When this card's [Activate: Main] effect says \"You may rest 1 of your cards\", what kind of cards can I rest to activate this effect?",
      "answer": "You can activate this effect by resting 1 of your active Leader, Character, Stage, or DON!! cards.",
      "updated_on": "2026-06-26"
    },
    {
      "question": "If neither I nor my opponent has a Character with a cost of 5 or more on the field, can I still activate this [Activate: Main] effect to rest 1 of my cards?",
      "answer": "Yes, you can. In this case, you will not set any of your DON!! cards as active after resting 1 of your cards, and the \"Then, you cannot play Character cards during this turn.\" part of the effect will not be applied.",
      "updated_on": "2026-06-26"
    }
  ]
