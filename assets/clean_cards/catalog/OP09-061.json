  "official_faq": [
    {
      "question": "If I activate a [DON!! −1] effect twice during my turn, can I still activate this [Your Turn] effect?",
      "answer": "No, you cannot. This effect only activates when 2 or more DON!! cards are returned to your DON!! deck at the same time.",
      "updated_on": "2024-11-29"
    },
    {
      "question": "I activated the [Activate: Main] effect of \"OP08-074 Black Maria\" and returned 2 or more DON!! cards to my deck at the end of a turn in which I had not yet activated this [Your Turn] effect. Can I still activate this [Your Turn] effect at this time?",
      "answer": "Yes, you can.",
      "updated_on": "2024-11-29"
    }
  ]
