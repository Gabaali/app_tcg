  "official_faq": [
    {
      "question": "Can this Character gain [Rush] if I do not give my opponent's Characters −3000 power?",
      "answer": "Yes, it can.",
      "updated_on": "2024-04-05"
    },
    {
      "question": "Can I activate the \"Give up to 2 of your opponent's Characters −3000 power during this turn\" effect if my Leader's type does not include \"Whitebeard Pirates\"?",
      "answer": "Yes, you can. In this case, this Character cannot gain [Rush].",
      "updated_on": "2024-04-05"
    },
    {
      "question": "Can I choose the same Character twice and give that Character −6000 power according to this [On Play] effect?",
      "answer": "No, you cannot.",
      "updated_on": "2024-04-05"
    }
