  "official_faq": [
    {
      "question": "If I choose to return 1 of my opponent's Characters with a cost of 5 or less to their hand using this [On Play] effect, can my opponent then choose not to play a Character card with a cost of 4 or less from their hand?",
      "answer": "Yes, they can.",
      "updated_on": "2026-02-06"
    },
    {
      "question": "If I did not choose to return 1 of my opponent's Characters with a cost of 5 or less to their hand using this [On Play] effect, can my opponent still play a Character card with a cost of 4 or less from their hand?",
      "answer": "No, they cannot. If you do not choose one of your opponent's Characters as the target of \"up to 1 of your opponent's Characters with a cost of 5 or less\" or if the chosen Character does not return to your opponent's hand due to another effect, your opponent cannot play a Character card with a cost of 4 or less from their hand.",
      "updated_on": "2026-02-06"
    },
    {
      "question": "If I did not give 1 rested DON!! card to my Leader and returned 1 of my opponent's Characters with a cost of 5 or less to their hand using this [On Play] effect, can my opponent still play a Character card with a cost of 4 or less from their hand?",
      "answer": "Yes, they can.",
      "updated_on": "2026-02-06"
    },
    {
      "question": "I play this Character when my opponent's Leader is \"OP12-081 Koala\" then activate its [On Play] effect, leading my opponent to play a Character card with a cost of 4 or less from their hand. In this case, can my opponent activate the effect of their Leader \"OP12-081 Koala\" which says it can be activated \"when your opponent plays a Character with a base cost of 8 or more, or when your opponent plays a Character using a Character's effect\"?",
      "answer": "No, they cannot. In this case, the player who played a Character using a Character's effect is your opponent whose Leader is \"OP12-081 Koala\".",
      "updated_on": "2026-02-06"
    }
  ]
}
