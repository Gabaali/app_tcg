  "official_faq": [
    {
      "question": "If my opponent plays a Character with [Rush] on their next turn after this [On Play] effect is activated, can that Character attack without them trashing 2 cards from their hand?",
      "answer": "Yes, they can attack without trashing 2 cards from their hand.",
      "updated_on": "2024-08-30"
    },
    {
      "question": "I had 3 or more Life cards when this [Main] effect was activated, but during my opponent's turn my number of Life cards dropped to 2 or less. In this case, does this [On Play] effect mean that my opponent's Characters will be unable to attack unless they trash 2 cards from their hand?",
      "answer": "No, your opponent's Characters will be able to attack without them trashing 2 cards from their hand.",
      "updated_on": "2024-08-30"
    }
