  "official_faq": [
    {
      "question": "When my opponent uses this card's [On K.O.] effect, can I activate a [Blocker] or [Counter] from my hand to prevent the damage?",
      "answer": "No, you cannot.",
      "updated_on": "2026-02-06"
    },
    {
      "question": "Can I activate the [Trigger] effect of a card added to my hand from my Life cards when my opponent uses this card's [On K.O.] effect to deal damage to me?",
      "answer": "Yes, you can.",
      "updated_on": "2026-02-06"
    },
    {
      "question": "If this card has [Banish] when activating its [On K.O.] effect, are the cards added to the hand from the player's Life cards trashed instead?",
      "answer": "No, they are not. [Banish] only causes cards added to the hand from the player's Life cards by damage dealt from an attack to be trashed instead.",
      "updated_on": "2026-02-06"
    },
    {
      "question": "If this card has [Double Attack] when I activate its [On K.O.] effect, can I deal 2 damage?",
      "answer": "No, you cannot. The effect of [Double Attack] only deals 2 damage when attacking.",
      "updated_on": "2026-02-06"
    },
    {
      "question": "Can I win the game by dealing damage with this [On K.O.] effect if my opponent has 0 Life cards?",
      "answer": "Yes, you can.",
      "updated_on": "2026-02-06"
    }
  ]
