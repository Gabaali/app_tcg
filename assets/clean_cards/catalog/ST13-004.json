    {
      "question": "When I place face-up Life cards back in my Life area according to this [On Play] effect, do I place them face- down?",
      "answer": "No. You must place face-up Life cards face-up, and face- down Life cards face-down.",
      "updated_on": "2024-04-05"
    },
    {
      "question": "When I use this [On Play] effect to place a face-up Life card on top of my deck, do I place that card face-down?",
      "answer": "Yes, the card should be placed face-down on top of your deck.",
      "updated_on": "2024-04-05"
    }
