  "official_faq": [
    {
      "question": "Can I activate this \"When you deal damage to your opponent's Life\" effect when the attack of a Character or Leader other than this card deals damage to my opponent's Life?",
      "answer": "Yes, you can.",
      "updated_on": "2024-04-05"
    },
    {
      "question": "Can I activate this \"When you deal damage to your opponent's Life\" effect when my opponent's Life card is moved to their hand or trashed due to the effect of another card?",
      "answer": "No, you cannot.",
      "updated_on": "2024-04-05"
    },
    {
      "question": "If a Character with [Double Attack] deals 2 damage to my opponent's Life, can I activate this \"When you deal damage to your opponent's Life\" effect twice?",
      "answer": "No, you cannot. You can only activate this effect once.",
      "updated_on": "2024-04-05"
    },
    {
      "question": "Does this \"When you deal damage to your opponent's Life\" effect activate before a [Trigger] resulting from that damage?",
      "answer": "First, your opponent checks their Life in accordance with the damage dealt, and then this \"When you deal damage to your opponent's Life\" effect activates. After that, if the checked Life card has a [Trigger], your opponent can choose to activate it.",
      "updated_on": "2024-04-05"
    }
  ]
