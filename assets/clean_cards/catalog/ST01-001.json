  "official_faq": [
    {
      "question": "Can I use this [Activate: Main] effect to give a Character a DON!! card that has already been given to another Character?",
      "answer": "No, you cannot. A DON!! card that has already been given to a Character is not a \"rested DON!! card\".",
      "updated_on": "2024-04-05"
    },
    {
      "question": "When I use this [Activate: Main] effect to give a Character a rested DON!! card, do I need to leave the DON!! card sideways?",
      "answer": "No, the orientation of a DON!! card given to a Character does not matter.",
      "updated_on": "2024-04-05"
    }
  ]
