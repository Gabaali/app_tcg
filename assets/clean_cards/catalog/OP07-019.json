  "official_faq": [
    {
      "question": "During my opponent's turn, can I choose not to use this [On Your Opponent's Attack] effect the first time my opponent attacks, and then use this [On Your Opponent's Attack] effect the second time my opponent attacks?",
      "answer": "Yes, you can.",
      "updated_on": "2025-02-28"
    },
    {
      "question": "My opponent attacked with \"OP01-060 Donquixote Doflamingo\", then used its [When Attacking] effect to play \"OP07-045 Jinbe\". If my opponent then plays a Character using Jinbe's [On Play] effect, can I use this [On Your Opponent's Attack] effect to rest that Character?",
      "answer": "No, you cannot. First, Jinbe is played with Donquixote Doflamingo's \"When Attacking\" effect, followed by the activation of this card's \"On Your Opponent's Attack\" effect. Then, Jinbe's \"On Play\" effect activates, allowing your opponent to play a Character from their hand.",
      "updated_on": "2025-02-28"
    }
  ]
