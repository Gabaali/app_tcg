  "official_faq": [
    {
      "question": "If I only play 1 Character card according to this [On Play] effect, do I play that Character rested?",
      "answer": "No, it is played as active.",
      "updated_on": "2024-04-19"
    },
    {
      "question": "I used this [On Play] effect to play Character A as active and Character B rested. Can I choose the order in which I activate the [On Play] effects of Character A and Character B?",
      "answer": "Yes, the player who played these Characters can activate their effects in the order of their choosing.",
      "updated_on": "2024-04-19"
    },
    {
      "question": "I had 4 Characters including this Character when I played this Character. I used this [On Play] effect to play Character A as active, and then trashed Character A while playing Character B rested. Can I activate Character A's [On Play] effect at this time?",
      "answer": "No, you cannot.",
      "updated_on": "2024-04-19"
    }
