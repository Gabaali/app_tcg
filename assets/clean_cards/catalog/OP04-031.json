  "official_faq": [
    {
      "question": "If I select my opponent's rested Character for this [On Play] effect and it then becomes active during that turn due to another effect, will that Character be rested during my opponent's next Refresh Phase?",
      "answer": "No, it will not.",
      "updated_on": "2024-04-05"
    },
    {
      "question": "Which player chooses the Leader or Character cards that do not become active according to this [On Play] effect?",
      "answer": "The player who activated this [On Play] effect chooses the cards upon activating this [On Play] effect.",
      "updated_on": "2024-04-05"
    },
    {
      "question": "Can I choose 3 of my opponent's Characters according to this [On Play] effect?",
      "answer": "Yes, you can.",
      "updated_on": "2024-04-05"
    }
  ]
