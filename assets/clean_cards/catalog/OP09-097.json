  "official_faq": [
    {
      "question": "Can I negate the effect \"Under the rules of this game, you may have any number of this card in your deck.\" using this card's effect?",
      "answer": "Yes, you can. However, even if your opponent has 5 or more cards in their deck that are the same as the card that had its effect negated, it will have no effect on the match.",
      "updated_on": "2024-11-29"
    },
    {
      "question": "I used this card's effect to negate the effect of my opponent's Leader for one turn when my opponent's Leader was \"OP03- 040 Nami\". What happens if my opponent's deck is reduced to 0 during that turn?",
      "answer": "In this case, your opponent will lose the game.",
      "updated_on": "2024-11-29"
    },
    {
      "question": "If a Character that had its effect negated by this card's effect is K.O.'d, can that Character's [On K.O.] effect be activated?",
      "answer": "No, it cannot.",
      "updated_on": "2024-11-29"
    },
    {
      "question": "If the card I choose for this card's effect is also receiving effects from another card, will this card's effect negate those effects as well?",
      "answer": "No, it will not.",
      "updated_on": "2024-11-29"
    }
  ]
