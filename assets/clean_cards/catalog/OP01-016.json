  "official_faq": [
    {
      "question": "Can I use this [On Play] effect to add a non-red {Straw Hat Crew} type card that is not [Nami] to my hand?",
      "answer": "Yes, you can.",
      "updated_on": "2024-04-05"
    },
    {
      "question": "What happens if there are no cards that I can add to my hand according to this [On Play] effect?",
      "answer": "You place all the cards you looked at from the top of your deck at the bottom of your deck in any order.",
      "updated_on": "2024-04-05"
    },
    {
      "question": "What happens according to this [On Play] effect if I have 4 or less cards in my deck?",
      "answer": "You will be able to look at all of the 4 or less cards in your deck. While looking at your deck, the number of cards in your deck will not be considered 0.",
      "updated_on": "2024-04-05"
    },
    {
      "question": "Can I use this [On Play] effect to add a [Nami] such as ST01-007 to my hand?",
      "answer": "No, you cannot.",
      "updated_on": "2024-04-05"
    }
  ]
}
