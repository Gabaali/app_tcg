  "official_faq": [
    {
      "question": "Does my opponent choose which Character to place at the bottom of their deck according to this [On Play] effect?",
      "answer": "Yes. Your opponent chooses 1 Character on their field and places it at the bottom of their deck.",
      "updated_on": "2026-02-06"
    },
    {
      "question": "Can I still use this [On Play] effect to trash 2 cards from my hand if my opponent has no Characters?",
      "answer": "Yes, you can. In this case, nothing occurs for the \"places 1 of their Characters at the bottom of the owner's deck\" effect.",
      "updated_on": "2026-02-06"
    }
