  "official_faq": [
    {
      "question": "Do I activate this effect before or after drawing a card at the start of my turn?",
      "answer": "You activate this effect before drawing a card. The effect is activated at the beginning of your Refresh Phase which is resolved as follows: \"Effects that activate at the start of your turn → All given DON!! cards are returned to your cost area → All rested cards become active → Draw Phase\".",
      "updated_on": "2025-05-23"
    },
    {
      "question": "Can I activate this effect when I have 7 or less DON!! cards on my field?",
      "answer": "You can, but nothing will happen as you do not meet the effect's condition of \"If you have 8 or more DON!! cards on your field\".",
      "updated_on": "2025-05-23"
    }
  ]
