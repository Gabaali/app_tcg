  "official_faq": [
    {
      "question": "Will this [Your Turn] effect give −5 cost to Character cards in my opponent's trash or hand?",
      "answer": "No, it will not. When \"Character\" is written in card text, it refers only to Characters on the field.",
      "updated_on": "2024-04-05"
    },
    {
      "question": "My opponent's Character with a cost of 6 was reduced to a cost of 1 due to this [Your Turn] effect. Its cost was then further reduced to 0 according to the −2 cost effect of [OP02-106 Tsuru]. If this Character is then removed from the field, what will the cost of my opponent's Character be?",
      "answer": "In that case, the cost will become 4.",
      "updated_on": "2024-04-05"
    },
    {
      "question": "Can I use this [On Play] effect to choose a Character with a cost that has been reduced to 0 according to this [Your Turn] effect?",
      "answer": "Yes, you can.",
      "updated_on": "2024-04-05"
    }
  ]
