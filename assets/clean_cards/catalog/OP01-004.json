  "official_faq": [
    {
      "question": "If this Character leaves the battle area due to an Event used by my opponent, can I draw a card according to this Character's effect?",
      "answer": "No, you cannot.",
      "updated_on": "2024-04-05"
    },
    {
      "question": "If my opponent activates an Event's [Trigger], can I draw a card according to this Character's effect?",
      "answer": "No, you cannot. Activating a [Trigger] is not the same as activating an Event.",
      "updated_on": "2024-04-05"
    },
    {
      "question": "If my opponent activates an Event while this Character has a DON!! card given to it, can I choose not to draw a card?",
      "answer": "No, you cannot.",
      "updated_on": "2024-04-05"
    },
    {
      "question": "At what time does the effect which states \"when your opponent activates an Event\" activate?",
      "answer": "After the Event has been activated and its effect has been resolved.",
      "updated_on": "2024-04-05"
    }
  ]
