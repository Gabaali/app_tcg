  "official_faq": [
    {
      "question": "Can I also activate this [Your Turn] effect when a card is removed from my Life cards?",
      "answer": "Yes, you can. This effect can be activated regardless of whether the card is removed from your Life cards or your opponent's Life cards.",
      "updated_on": "2025-05-23"
    },
    {
      "question": "During my turn, I used the [On Play] effect of \"OP06- 106 Kouzuki Hiyori\" to add a card from my Life cards to my hand, then add a card from my hand to my Life cards. Can I activate this Leader's [Your Turn] effect at this time?",
      "answer": "Yes, you can.",
      "updated_on": "2025-05-23"
    },
    {
      "question": "During my turn, I used the [On Play] effect of \"EB01- 052 Viola\" to look at all of my opponent's Life cards and place them back in their Life area in any order. Can I activate this Leader's [Your Turn] effect at this time?",
      "answer": "No, you cannot.",
      "updated_on": "2025-05-23"
    }
  ]
