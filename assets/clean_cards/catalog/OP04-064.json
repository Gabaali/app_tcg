  "official_faq": [
    {
      "question": "My Leader is [OP04-058 Crocodile] and I have 6 DON!! cards on my field when I activate this Character's [Trigger], return 2 DON!! cards from my field to my DON!! deck, and play this Character with 4 DON!! cards on my field. At this time, can I use this Character's [On Play] effect to draw 1 card?",
      "answer": "Yes, you can. Your Leader's [Opponent's Turn] effect will have activated first, so you will have added 1 DON!! card, meaning you have 5 DON!! cards. Then, you will add 1 more DON!! card with this Character's [On Play] effect, so you will be able to draw 1 card.",
      "updated_on": "2024-04-05"
    },
    {
      "question": "Can I use this [Trigger] effect to return DON!! cards to my DON!! deck without playing this Character?",
      "answer": "No, you cannot. In this case, you must play this Character.",
      "updated_on": "2024-04-05"
    }
  ]
