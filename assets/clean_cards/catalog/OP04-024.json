  "official_faq": [
    {
      "question": "If this Character is rested on a turn in which I have not yet used this [Opponent's Turn] effect, can I use this [Opponent's Turn] effect to rest my opponent's Character?",
      "answer": "Yes, you can.",
      "updated_on": "2024-04-05"
    },
    {
      "question": "If I have not yet used this [Opponent's Turn] effect during a turn, can I decide not to use this [Opponent's Turn] effect to rest a Character my opponent plays, and instead rest the next Character played?",
      "answer": "No, you cannot.",
      "updated_on": "2024-04-05"
    },
    {
      "question": "If my Leader does not have the {Donquixote Pirates} type, can I still use this [On Play] effect to rest up to 1 of my opponent's Characters with a cost of 4 or less?",
      "answer": "Yes, you can.",
      "updated_on": "2024-04-05"
    },
    {
      "question": "I had this Character on my field when my opponent played [OP03-013 Marco] and used its [On Play] effect to K.O. this Character. In this case, can I still activate this Character's [Opponent's Turn] effect?",
      "answer": "No, you cannot.",
      "updated_on": "2024-04-05"
    }
  ]
