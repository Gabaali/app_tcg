  "official_faq": [
    {
      "question": "I activated this [When Attacking] effect, and afterwards my opponent played a Character with 2000 power or less in the same turn. Will that Character be able to activate [Blocker] during that turn?",
      "answer": "Yes, it will.",
      "updated_on": "2025-05-23"
    },
    {
      "question": "My opponent's Character had 3000 power or more when I activated this [When Attacking] effect, but its power subsequently dropped to 2000 or less. Will it still be able to activate [Blocker] during that turn?",
