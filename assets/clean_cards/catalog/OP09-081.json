  "official_faq": [
    {
      "question": "My opponent took damage during the same turn in which I used this [Activate: Main] effect, and their Life card was \"OP08- 106 Nami\". What happens to the \"[Trigger] Activate this card's [On Play] effect.\" on \"OP08-106 Nami\" in this case?",
      "answer": "In this case, your opponent can choose to activate the [Trigger] effect on \"OP08-106 Nami\", but because [On Play] effects are negated, nothing will happen and [OP08-106 Nami] will be trashed.",
      "updated_on": "2024-11-29"
    },
    {
      "question": "Can I use cards with [On Play] effects in a deck with this Leader?",
      "answer": "Yes, you can include cards with [On Play] effects in the same deck as this Leader. However, all [On Play] effects will be negated due to this Leader's effect.",
      "updated_on": "2024-11-29"
    },
    {
      "question": "If my opponent plays a Character with an [On Play]/[When Attacking] effect on the turn after I used this [Activate: Main] effect, will my opponent be able to activate that Character's [On Play]/[When Attacking] effect?",
      "answer": "No, they will not.",
      "updated_on": "2024-11-29"
    },
    {
      "question": "If my opponent attacks with a Character with an [On Play]/[When Attacking] effect on the turn after I used this [Activate: Main] effect, will my opponent be able to activate that Character's [On Play]/[When Attacking] effect?",
      "answer": "Yes, they will.",
      "updated_on": "2024-11-29"
    },
    {
      "question": "I used this [Activate: Main] effect when my opponent's Leader was \"PRB01-001 Sanji\", and my opponent played a Character with an [On Play] effect the next turn. Can my opponent use the [Activate: Main] effect on \"PRB01-001 Sanji\" on that Character?",
      "answer": "No, they cannot.",
      "updated_on": "2024-11-29"
    },
    {
      "question": "While [On Play] effects are being negated by this card, are my Characters with only [On Play] effects treated as Characters with no base effects?",
      "answer": "No, they are not.",
      "updated_on": "2024-11-29"
    }
  ]
