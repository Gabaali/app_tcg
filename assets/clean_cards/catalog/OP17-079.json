  "official_faq": [
    {
      "question": "If this Leader's effect is negated by another effect such as “negate its effects,” do my Characters with a cost of 12 or more lose [Blocker] while that effect is negated?",
      "answer": "Yes, they do.",
      "updated_on": "2026-08-21"
    },
    {
      "question": "If one of my Characters with a cost of 12 or more has gained [Blocker] from this Leader's effect, and that Character is affected by another effect such as “negate its effects,” can that Character activate [Blocker]?",
      "answer": "In this case, if the Character affected by the “negate its effects” effect still has a cost of 12 or more, it can activate [Blocker]. However, if an effect such as “This Character gains +12 cost.” is negated and its cost therefore becomes lower than 12, it loses [Blocker] while that effect is negated.",
      "updated_on": "2026-08-21"
    }
  ]
