  "official_faq": [
    {
      "question": "If this Character is subject to a \"gains +1000 power during this turn\" effect due to another card or DON!! card, does this [Activate: Main] effect reset this Character's power to its base power?",
      "answer": "No, it does not.",
      "updated_on": "2024-04-19"
    },
    {
      "question": "I activated this [Activate: Main] effect after this Character gained [Banish] according to the [On Play] effect of \"OP06-101 O-Nami\". What happens if I then attack with this Character and deal damage to my opponent's Leader?",
      "answer": "No Trigger is activated according to this damage and your opponent trashes a Life card.",
      "updated_on": "2024-04-19"
    },
    {
      "question": "Can a Character that has had its effect negated according to this [On Play] effect be subsequently chosen as the target of an effect by another card during that turn?",
      "answer": "Yes, it can.",
      "updated_on": "2024-04-19"
    },
    {
      "question": "Is a Character that has had its effect negated according to this [On Play] effect treated as a \"Character with no base effect\"?",
      "answer": "No, it is not.",
      "updated_on": "2024-04-19"
    },
    {
      "question": "If I activate this [Activate: Main] effect on the turn this Character is played, can this Character attack?",
      "answer": "No, it cannot attack. This Character cannot attack on the turn it is played unless it gains [Rush] according to another card's effect.",
      "updated_on": "2024-04-19"
    }
  ]
